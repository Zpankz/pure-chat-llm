{
  "name": "voice-agent",
  "version": "2.0.0-beta.7",
  "description": "Turn notes into conversations with chatGPT",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "format": "prettier --write \"src/**/*.ts\" && prettier --write \"*.sh\" && prettier --write \"**/*.md\"",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json src/assets/s.json",
    "release": "bash Release.sh",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "copy-to-mobile-vault": "kioclient5 --overwrite copy styles.css manifest.json main.js \"mtp:/Armor X31 Pro/Internal shared storage/Documents/Obsidian/.obsidian/plugins/pure-chat-llm/\"",
    "test": "node tests/unit/run.mjs"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "chatbot",
    "language model",
    "LLM",
    "notes"
  ],
  "author": "Justice Vellacott",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/language": "^6.11.3",
    "@codemirror/view": "^6.38.3",
    "@eslint/js": "^9.39.2",
    "@types/glob-to-regexp": "^0.4.4",
    "@types/node": "^25.0.2",
    "builtin-modules": "5.0.0",
    "esbuild": "0.28.2",
    "eslint": "^9.39.2",
    "eslint-plugin-jsdoc": "^62.5.4",
    "eslint-plugin-obsidianmd": "^0.1.9",
    "globals": "^16.5.0",
    "obsidian": "latest",
    "prettier": "^3.7.4",
    "prettier-plugin-sh": "^0.18.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1"
  },
  "dependencies": {
    "@earendil-works/chord": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-durable": "1.5.2",
    "@earendil-works/pi-schema": "1.5.2",
    "@relate/relate-wasm": "1.1.0",
    "diff": "^8.0.3",
    "glob-to-regexp": "^0.4.1",
    "pele": "1.13.0"
  },
  "overrides": {
    "ws": "8.21.0"
  }
}
